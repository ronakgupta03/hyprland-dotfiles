#!/usr/bin/env bash
# Push a freshly generated palette into everything already running.
# matugen only writes files; each app needs its own nudge to re-read them.
CACHE="$HOME/.cache/rice"     # literal ~/.cache, matching matugen's config.toml

# Hyprland: colors.lua is only read on reload, and a reload would also reset
# live state (focus mode), so push the colours into the running config instead.
if [[ -s "$CACHE/hypr-colors.lua" ]]; then
    hyprctl eval "$(< "$CACHE/hypr-colors.lua")" >/dev/null 2>&1
fi

# SwayFX: reload border and accent colors live
if [[ -n "$SWAYSOCK" && -s "$CACHE/palette.css" ]]; then
    primary="$(grep '@define-color primary ' "$CACHE/palette.css" | head -n 1 | awk '{print $3}' | tr -d ';')"
    if [[ -n "$primary" ]]; then
        swaymsg client.focused "$primary" "$primary" "#ffffff" "$primary" "$primary" >/dev/null 2>&1
    fi
fi

# waybar: nothing to do. reload_style_on_change picks up the new colors.css by
# itself; a SIGUSR2 on top restarted every module and made the bar flicker.
pkill -USR1 -x kitty                    # re-read kitty.conf, colours included
pkill -USR2 -x cava                     # colours only
pkill -HUP -x xsettingsd >/dev/null 2>&1 # reload X11 / Xwayland theme
# nvim: instances started via init.lua listen on $XDG_RUNTIME_DIR/nvim.<pid>.0.
# Re-source the colorscheme so the new matugen palette file is picked up live.
if command -v nvim >/dev/null; then
    for sock in "$XDG_RUNTIME_DIR"/nvim.*.0; do
        [[ -S "$sock" ]] && nvim --server "$sock" --remote-send ':silent colorscheme matugen<CR>' >/dev/null 2>&1
    done
fi
"$HOME/.local/bin/rice-kde-colors" >/dev/null 2>&1

# GTK: follow `rice-wallpaper mode`. The theme name is set via Adwaita and
# back, because GTK3 apps re-read their CSS only when the NAME changes.
# adw-gtk3 (light) is only used if it is installed.
if command -v gsettings >/dev/null; then
    mode="$(cat "$CACHE/mode" 2>/dev/null)"
    if [[ "$mode" == light && (-d /usr/share/themes/adw-gtk3 || -d "$HOME/.local/share/themes/adw-gtk3" || -d "$HOME/.themes/adw-gtk3") ]]; then
        theme=adw-gtk3; scheme=prefer-light
    else
        theme=adw-gtk3-dark; scheme=prefer-dark
    fi
    gsettings set org.gnome.desktop.interface color-scheme "$scheme"
    gsettings set org.gnome.desktop.interface gtk-theme "'Adwaita'"
    gsettings set org.gnome.desktop.interface gtk-theme "$theme"
fi
exit 0
